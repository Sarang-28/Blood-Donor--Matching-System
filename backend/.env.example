PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Prefer a non-owner, non-superuser runtime account. Use a separate migration account.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=bloodmatch_app
DB_PASSWORD=
DB_NAME=blood_donor_db
DB_SSL=false
# Production always verifies TLS. Optional provider root CA PEM, with escaped newlines.
DB_SSL_CA=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
MATCH_RADIUS_KM=10
DONATION_COOLDOWN_DAYS=90
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional deployment-aware trust proxy, see deployment guide before setting.
TRUST_PROXY=
