# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database with PostGIS
# Option 1: Full connection string (e.g., Supabase, Neon, Render)
DATABASE_URL=
# Option 2: Individual local parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blood_donor_db
DB_SSL=false

# JWT Configuration
JWT_SECRET=super_secret_blood_donor_matching_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# Optional Services (Notifications)
# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
